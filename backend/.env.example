# Legacy aggregate template (deprecated).
# Use service-specific env files under backend/cmd/*/.env.example instead.
DATABASE_URL=postgres://indel:demo_password@192.168.1.6:5432/indel?sslmode=disable
DB_SSLMODE=disable
DB_HOST=192.168.1.6
DB_PORT=5432
DB_USER=indel
DB_PASSWORD=demo_password
DB_NAME=indel

# Kafka/Redpanda
KAFKA_BROKERS=192.168.1.6:9092
KAFKA_USER=
KAFKA_PASS=

# Redis
REDIS_URL=192.168.1.6:6379

# API URLs
API_BASE_URL=http://192.168.1.6:8000
ML_SERVICE_URL=http://192.168.1.6:5000
ML_TIMEOUT_MS=3000
ML_RETRY_COUNT=2
# Legacy per-feature ML URLs (optional, fallback-only)
PREMIUM_ML_URL=http://192.168.1.6:5000
FRAUD_ML_URL=http://192.168.1.6:5000
FRAUD_SERVICE_URL=http://192.168.1.6:5000
FORECAST_ML_URL=http://192.168.1.6:5000
PLATFORM_API_URL=http://192.168.1.6:8004
VITE_PLATFORM_API_URL=http://192.168.1.6:8004
VITE_INSURER_API_URL=http://192.168.1.6:8004
VITE_CORE_API_URL=http://192.168.1.6:8000

# CORS/Allowed Origins
INDEL_ALLOWED_ORIGINS=http://localhost:5173,http://192.168.1.6:5173,https://indel-insurer-dashboard.vercel.app,https://indel-platform-dashboard.vercel.app

# Demo keys (change in production)
INDEL_DEMO_RESET_KEY=change-me-demo-reset-key
INDEL_DEMO_ALLOWED_ROLES=worker,admin,platform_admin,ops_manager
INDEL_DEMO_DESTRUCTIVE_ROLES=admin,platform_admin
INDEL_CORE_INTERNAL_ALLOWED_ROLES=worker,admin,platform_admin,ops_manager
INDEL_PLATFORM_OPERATOR_ALLOWED_ROLES=worker,admin,platform_admin,ops_manager
INDEL_PLATFORM_WEBHOOK_ALLOWED_ROLES=worker,admin,platform_admin,ops_manager
INDEL_PLATFORM_WEBHOOK_KEY=change-me-webhook-key

JWT_SECRET=indel-dev-secret
INDEL_ENV=development
LOG_LEVEL=info

# KeepAlive poller targets (core service). Prefer setting one of:
# 1) KEEPALIVE_URLS (comma-separated full health URLs)
# 2) PUBLIC_CORE_URL (base URL, /health is appended)
# 3) RENDER_EXTERNAL_URL (base URL, /health is appended)
# KEEPALIVE_URLS=https://indel-backend.onrender.com/health
# PUBLIC_CORE_URL=https://indel-backend.onrender.com
