
# Backend .env.example - safe template, no secrets
DATABASE_URL=
DB_SSLMODE=disable
DB_HOST=postgres
DB_PORT=5432
DB_USER=indel
DB_PASSWORD=demo_password
DB_NAME=indel

# Kafka/Redpanda
KAFKA_BROKERS=
KAFKA_USER=
KAFKA_PASS=

# Redis
REDIS_URL=

# API URLs
API_BASE_URL=
PREMIUM_ML_URL=
FRAUD_ML_URL=
FRAUD_SERVICE_URL=
FORECAST_ML_URL=
PLATFORM_API_URL=
VITE_PLATFORM_API_URL=
VITE_INSURER_API_URL=
VITE_CORE_API_URL=

# CORS/Allowed Origins
INDEL_ALLOWED_ORIGINS=

# Demo keys (change in production)
INDEL_DEMO_RESET_KEY=change-me-demo-reset-key
INDEL_DEMO_ALLOWED_ROLES=worker,admin,platform_admin,ops_manager
INDEL_DEMO_DESTRUCTIVE_ROLES=admin,platform_admin
INDEL_CORE_INTERNAL_ALLOWED_ROLES=worker,admin,platform_admin,ops_manager
INDEL_PLATFORM_OPERATOR_ALLOWED_ROLES=worker,admin,platform_admin,ops_manager
INDEL_PLATFORM_WEBHOOK_ALLOWED_ROLES=worker,admin,platform_admin,ops_manager
INDEL_PLATFORM_WEBHOOK_KEY=change-me-webhook-key

JWT_SECRET=indel-dev-secret
INDEL_ENV=development
LOG_LEVEL=info
