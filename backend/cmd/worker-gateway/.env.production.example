INDEL_ENV=production
PORT=8001
INDEL_ALLOWED_ORIGINS=https://your-domain.example

CORE_URL=http://core:8000
ML_SERVICE_URL=http://ml-service.default.svc.cluster.local:8000
ML_TIMEOUT_MS=3000
ML_RETRY_COUNT=2

DB_URL=postgres://indel:${DB_PASSWORD}@postgres:5432/indel?sslmode=disable
REDIS_URL=redis:6379
KAFKA_BROKERS=kafka:9092

POLICY_ACTIVATION_POLL_SECONDS=30
POLICY_LOCKIN_HOURS=48
DISRUPTION_BLOCK_LOOKAHEAD_HOURS=12
LOG_LEVEL=info
