INDEL_ENV=development
PORT=8001
CORE_URL=http://192.168.1.6:8000
ML_SERVICE_URL=http://192.168.1.6:5000
ML_TIMEOUT_MS=3000
ML_RETRY_COUNT=2
INDEL_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5176

# Database: set either DB_URL or DATABASE_URL
