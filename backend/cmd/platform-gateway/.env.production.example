INDEL_ENV=production
PORT=8003
INDEL_ALLOWED_ORIGINS=https://your-domain.example

CORE_URL=http://core:8000
DB_URL=postgres://indel:${DB_PASSWORD}@postgres:5432/indel?sslmode=disable
REDIS_URL=redis:6379
KAFKA_BROKERS=kafka:9092

INDEL_PLATFORM_OPERATOR_ALLOWED_ROLES=admin,platform_admin,ops_manager
INDEL_PLATFORM_WEBHOOK_ALLOWED_ROLES=admin,platform_admin,ops_manager
INDEL_PLATFORM_WEBHOOK_KEY=${INDEL_PLATFORM_WEBHOOK_KEY}
LOG_LEVEL=info
